{
  "name": "svelte-remixicon",
  "description": "An icon library for Svelte/SvelteKit based on Remix Icon. Consists of more than 3000 icons.",
  "version": "2.10.1",
  "license": "MIT",
  "main": "dist/index.js",
  "author": {
    "name": "Antu Saha",
    "email": "imantu09@gmail.com",
    "url": "https://github.com/aantusahaa"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aantusahaa/svelte-remixicon"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "remixicon",
    "svg icon",
    "icon library",
    "icon"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "node build && svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./*.svelte": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte"
    }
  },
  "typesVersions": {
    ">4.0": {
      ".": [
        "./dist/index.d.ts"
      ],
      "*.svelte": [
        "./dist/icons/*.svelte.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^3.54.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
